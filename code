-- Pre-allocate whichever table the starting mode needs
if Config.Mode == "Snow" then
    ensureFlakesCount(Config.SNOW_COUNT)
elseif Config.Mode == "Fireflies" then
    ensureFirefliesCount(Config.FIREFLY_COUNT)
else  -- Rain or Thunder
    local startCount = Config.RAIN_COUNT
