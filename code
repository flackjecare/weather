    THUNDER_BOLT_HEIGHT         = 200,
    THUNDER_BOLT_RADIUS         = 120,
    THUNDER_BOLT_BRANCH_CHANCE  = 0.75,
    THUNDER_BOLT_MAX_BRANCHES   = 3,
    THUNDER_FLASH_ENABLED       = false,
    THUNDER_FLASH_DURATION      = 0.25,
    THUNDER_FLASH_MAX_ALPHA     = 0.35,

    -- Render
    MAX_RENDER_DISTANCE = 400,
