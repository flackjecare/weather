    RAIN_SPEED_MAX   = 75,
    RAIN_BASE_SPEED  = 60,
    RAIN_LENGTH      = 2,
    RAIN_ANGLE_X     = 1,
    RAIN_ANGLE_Z     = 3,

    -- Splash
    SPLASH_ENABLED   = true,
