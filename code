-- Initialize
-- ============================================================
nextBoltTimer = randf(Config.THUNDER_BOLT_MIN_INTERVAL, Config.THUNDER_BOLT_MAX_INTERVAL)

-- Pre-allocate whichever table the starting mode needs
if Config.Mode == "Snow" then
    ensureFlakesCount(Config.SNOW_COUNT)
else
    local startCount = Config.RAIN_COUNT
    if Config.Mode == "Thunder" then
        startCount = math.floor(Config.RAIN_COUNT * Config.THUNDER_COUNT_MULT)
    end
    ensureDropsCount(startCount)
end

-- ============================================================
-- Main loop
-- ============================================================
cleanupConnection = RunService.RenderStepped:Connect(function(dt)
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local prevLines   = activeLines
    local prevCircles = activeCircles
    local prevTris    = activeTris
    activeLines   = 0
    activeCircles = 0
    activeTris    = 0

    -- Master kill switch: hide everything but keep tables alive
    if not Config.Enabled then
        for _, d in ipairs(drops) do
            if d.Line then d.Line.Visible = false end
        end
        if flashSquare then flashSquare.Visible = false end
        flashAge = -1
        hideUnused(prevLines, prevCircles, prevTris)
        return
    end

    local camPos = camera.CFrame.Position
    local clampedDt = math.min(dt or 0.016, 0.1)

    -- Tear down thunder-only state when not in thunder mode
    if Config.Mode ~= "Thunder" then
        if #activeBolts > 0 then activeBolts = {} end
        if flashSquare then flashSquare.Visible = false end
        flashAge = -1
    end

    if Config.Mode == "Snow" then
        if #drops > 0 then clearDrops() end
        ensureFlakesCount(Config.SNOW_COUNT)
        tickSnow(clampedDt, camPos, camera)
    else
        -- Rain or Thunder
        if #s_flakes > 0 then clearFlakes() end
        local rainCount = Config.RAIN_COUNT
        if Config.Mode == "Thunder" then
            rainCount = math.floor(Config.RAIN_COUNT * Config.THUNDER_COUNT_MULT)
        end
        ensureDropsCount(rainCount)
        if Config.Mode == "Thunder" then
            tickThunder(clampedDt, camPos, camera)
        else
            tickRain(clampedDt, camPos, camera)
        end
    end

    hideUnused(prevLines, prevCircles, prevTris)
end)
